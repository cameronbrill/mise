#!/usr/bin/env bash
# Verifies `mise affected` returns affected projects + transitive dependents.
set -e
export MISE_EXPERIMENTAL=1

# `git -c init.defaultBranch=main init` works on every git ≥ 2.0; `-b` requires 2.28.
git -c init.defaultBranch=main init -q .
git config user.email test@test.com
git config user.name "Test"

cat <<'TOML' >mise.toml
experimental_monorepo_root = true
[monorepo]
config_roots = ["apps/*", "libs/*"]
TOML

mkdir -p apps/web libs/shared

cat <<'TOML' >apps/web/mise.toml
[project]
name = "web"
sources = ["**/*.ts"]
[tasks.build]
run = 'echo "build web"'
TOML
cat <<'JSON' >apps/web/package.json
{"name":"@org/web","dependencies":{"@org/shared":"*"}}
JSON

cat <<'TOML' >libs/shared/mise.toml
[project]
name = "shared"
sources = ["**/*.ts"]
TOML
cat <<'JSON' >libs/shared/package.json
{"name":"@org/shared"}
JSON

cat <<'JSON' >package.json
{"name":"root","workspaces":["apps/*","libs/*"]}
JSON

git add -A
git commit -qm "initial"
git checkout -qb feature
echo "// changed" >libs/shared/index.ts
git add -A
git commit -qm "shared change"

# `set -e` ensures any failing assertion aborts the script — using a brace
# group instead of a subshell so `exit 1` actually exits the test (the
# previous `(... && exit 1)` form only exited the subshell).
fail() { echo "FAIL: $1" >&2; exit 1; }

echo "=== mise affected --base main --head HEAD ==="
out=$(mise affected --base main --head HEAD)
echo "$out"
echo "$out" | grep -qx "//libs/shared" || fail "shared not in output"
echo "$out" | grep -qx "//apps/web" || fail "web not in output (transitive via npm dep)"

echo "=== mise affected --base main --head HEAD --target build ==="
out=$(mise affected --base main --head HEAD --target build)
echo "$out"
echo "$out" | grep -qx "//apps/web" || fail "web (has build target) not in output"
if echo "$out" | grep -qx "//libs/shared"; then
  fail "shared has no build target, should not appear"
fi

echo "=== mise affected --base main --head HEAD --exclude //apps/web ==="
out=$(mise affected --base main --head HEAD --exclude //apps/web)
echo "$out"
if echo "$out" | grep -qx "//apps/web"; then
  fail "web should be excluded"
fi
echo "$out" | grep -qx "//libs/shared" || fail "shared not in output"

echo "=== Affected basic test passed ==="
